rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{groupId} {
      allow read, write: if request.auth != null;
    }

    match /groups/{groupId}/transactions/{txId} {
      allow read, write: if request.auth != null;
    }

    match /groups/{groupId}/transactions/{txId}/audit/{auditId} {
      allow read, write: if request.auth != null;
    }

    match /groups/{groupId}/paymentQrs/{memberId} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'dataUrl',
          'mimeType',
          'width',
          'height',
          'originalName',
          'schemaVersion',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 700000
        && request.resource.data.mimeType in ['image/webp', 'image/jpeg', 'image/png']
        && request.resource.data.width is int
        && request.resource.data.width > 0
        && request.resource.data.width <= 1200
        && request.resource.data.height is int
        && request.resource.data.height > 0
        && request.resource.data.height <= 1200
        && request.resource.data.originalName is string
        && request.resource.data.originalName.size() <= 120
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedBy == memberId;
    }
  }
}
